{
  "name": "pi-nest",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm start",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test && node --test scripts/web-release.test.mjs scripts/patch-ponytail.test.mjs",
    "start:local": "pnpm start",
    "dev:hmr": "pnpm --parallel --filter './apps/*' dev",
    "start": "pnpm build && node scripts/start-local.mjs"
  },
  "devDependencies": {
    "vitest": "5.0.1"
  }
}
