{
  "name": "@pi-nest/pi-adapter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "spike:list": "pnpm run build && node dist/scripts/list-sessions.js",
    "spike:open": "pnpm run build && node dist/scripts/open-session.js",
    "spike:restore": "pnpm run build && node dist/scripts/restore-session.js",
    "spike:restore-persistent": "pnpm run build && node dist/scripts/restore-persistent-session.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.86.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "~6.0.2"
  }
}
